# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Neo4j graph database for the Oracle Dependency Engine.
# Start a local instance with: docker compose up -d
# Leave NEO4J_URI unset to run without the graph (analyzer demos still work).
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="oracleimpact"

# Live Oracle discovery (optional): read-only data-dictionary connection used
# by POST /api/v2/ingest/discover. oracledb thin mode — requires Oracle 12.1+.
# ORACLE_USER="your_readonly_user"
# ORACLE_PASSWORD="your_password"
# ORACLE_CONNECT_STRING="host:1521/PDB"

# Maximum traversal depth for impact analysis queries (default 8).
# IMPACT_MAX_DEPTH="8"

# HTTP port for the server (default 3000). Override when 3000 is taken.
# PORT="3010"
